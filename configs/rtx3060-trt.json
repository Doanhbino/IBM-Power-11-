{
  "model": "models/rfdetr.onnx",
  "input_npz": "data/input.npz",
  "mode": "model",
  "backend": "tensorrt",
  "threads": 1,
  "inter_threads": 1,
  "spinning": false,
  "warmup": 30,
  "iterations": 1000,
  "seed": 42,
  "size": [
    640,
    640
  ],
  "mean": [
    0.485,
    0.456,
    0.406
  ],
  "std": [
    0.229,
    0.224,
    0.225
  ],
  "boxes_output": "dets",
  "logits_output": "labels",
  "background_index": -1,
  "top_k": 300,
  "threshold": 0.25,
  "provider_options": {
    "trt_engine_cache_enable": true,
    "trt_engine_cache_path": "runs/trt-cache",
    "trt_fp16_enable": false
  }
}
